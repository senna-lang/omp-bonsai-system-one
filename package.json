{
  "name": "omp-bonsai-system-one",
  "version": "0.1.0",
  "description": "Local System One judge for omp on frozen Ternary-Bonsai-4B, with an optional model router",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/senna-lang/omp-bonsai-system-one.git"
  },
  "homepage": "https://github.com/senna-lang/omp-bonsai-system-one#readme",
  "keywords": [
    "omp-plugin",
    "oh-my-pi",
    "pi-package",
    "system-one",
    "mlx",
    "local-llm"
  ],
  "files": [
    "judge.ts",
    "router.ts",
    "server.ts",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "omp": {
    "extensions": [
      "./judge.ts"
    ],
    "features": {
      "router": {
        "description": "Switch the session to @smol / @mid (or @default) / @slow from the first prompt's rated difficulty",
        "default": false,
        "extensions": [
          "./router.ts"
        ]
      }
    }
  }
}
